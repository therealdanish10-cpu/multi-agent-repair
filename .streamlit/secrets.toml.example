# Copy to .streamlit/secrets.toml for local testing, or paste into the
# Streamlit Community Cloud "Secrets" dashboard when deploying.
# Do NOT commit real secrets to version control.

GEMINI_API_KEY = "your_api_key_here"
GEMINI_MODEL = "your_gemini_model_placeholder"
MAX_ATTEMPTS = 3
TEST_TIMEOUT_SECONDS = 10
LLM_TIMEOUT_SECONDS = 60
LLM_MAX_RETRIES = 3
ENABLE_CODE_EXECUTION = false
APP_PASSWORD = "your_optional_app_password_here"
